
import os
import telebot
from telebot.types import ReplyKeyboardMarkup, KeyboardButton

TOKEN = os.getenv("BOT_TOKEN")

if not TOKEN:
    raise RuntimeError("BOT_TOKEN is missing")

bot = telebot.TeleBot(TOKEN)

def main_menu():
    keyboard = ReplyKeyboardMarkup(resize_keyboard=True)
    keyboard.row("📚 الكورسات", "🎥 الفيديوهات")
    keyboard.row("📂 الملفات والملخصات", "👤 حسابي")
    keyboard.row("ℹ️ المساعدة")
    return keyboard

@bot.message_handler(commands=["start"])
def start(message):
    bot.send_message(
        message.chat.id,
        "مرحبًا بك في تقنية ببساطة 💻\n\n"
        "منصتك لتعلم التكنولوجيا والمهارات الرقمية "
        "بطريقة سهلة وعملية.\n\n"
        "اختر القسم الذي تريد استكشافه 👇",
        reply_markup=main_menu()
    )

@bot.message_handler(commands=["help"])
def help_command(message):
    bot.send_message(
        message.chat.id,
        "أهلاً بك في تقنية ببساطة 💻\n"
        "استخدم الأزرار للتنقل بين الأقسام."
    )

@bot.message_handler(func=lambda m: m.text == "📚 الكورسات")
def courses(message):
    bot.send_message(
        message.chat.id,
        "📚 قسم الكورسات\n\n"
        "قريبًا ستجد هنا الكورسات التعليمية المجانية."
    )

@bot.message_handler(func=lambda m: m.text == "🎥 الفيديوهات")
def videos(message):
    bot.send_message(
        message.chat.id,
        "🎥 مكتبة الفيديوهات\n\n"
        "قريبًا ستتوفر الشروحات التعليمية."
    )

@bot.message_handler(func=lambda m: m.text == "📂 الملفات والملخصات")
def files(message):
    bot.send_message(
        message.chat.id,
        "📂 الملفات والملخصات\n\n"
        "قريبًا ستتوفر الملفات التعليمية."
    )

@bot.message_handler(func=lambda m: m.text == "👤 حسابي")
def account(message):
    bot.send_message(
        message.chat.id,
        f"👤 حسابك في تقنية ببساطة\n"
        f"رقم المستخدم: {message.from_user.id}"
    )

@bot.message_handler(func=lambda m: m.text == "ℹ️ المساعدة")
def help_section(message):
    help_command(message)

@bot.message_handler(func=lambda m: True)
def unknown(message):
    bot.send_message(
        message.chat.id,
        "من فضلك اختر أحد الأقسام من القائمة 👇",
        reply_markup=main_menu()
    )

if __name__ == "__main__":
    print("Tech Bebasata bot is running...")
    bot.infinity_polling(skip_pending=True)
